<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/dark_background">

    <TextView
        android:id="@+id/tvTicketHistoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nav_history"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/etix_blue_light"
        android:layout_marginBottom="12dp" />

    <SearchView
        android:id="@+id/searchTickets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:queryHint="@string/search_hint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnThisMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/this_month"
            style="@style/Shape" />

        <Button
            android:id="@+id/btnCustomRange"
            android:layout_width="152dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/custom_range"
            style="@style/Shape" />

        <Button
            android:id="@+id/btnClearFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/clear_filter"
            style="@style/Shape" />
    </LinearLayout>

    <TextView
        android:id="@+id/textEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/empty_history"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="@color/gray_500"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTickets"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>