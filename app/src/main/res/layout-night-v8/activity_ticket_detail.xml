<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/dark_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- 🏪 Magasin -->
        <TextView
            android:id="@+id/tvDetailStore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Magasin"
            android:textStyle="bold"
            android:textColor="@color/etix_blue_light"
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

        <!-- 💰 Montant -->
        <TextView
            android:id="@+id/tvDetailAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Montant"
            android:textColor="@color/gray_400"
            android:layout_marginBottom="8dp" />

        <!-- 📅 Date -->
        <TextView
            android:id="@+id/tvDetailDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date"
            android:textColor="@color/gray_400"
            android:layout_marginBottom="8dp" />

        <!-- 🏷️ Catégorie -->
        <TextView
            android:id="@+id/tvDetailCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Catégorie"
            android:textColor="@color/gray_400"
            android:layout_marginBottom="8dp" />

        <!-- 📝 Description -->
        <TextView
            android:id="@+id/tvDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textColor="@color/gray_400"
            android:layout_marginBottom="8dp" />

        <!-- ✏️ Bouton Modifier -->
        <Button
            android:id="@+id/btnEditTicket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modifier le ticket"
            android:layout_marginTop="16dp"
            style="@style/Shape" />
    </LinearLayout>
</ScrollView>