<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Formulaire ticket V2 (iOS TicketForm) -->
    <style name="V2.FieldLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/v2_text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Badge de confiance après un scan (iOS : « Vérifié » vert, « À vérifier » orange) ; masqué par défaut -->
    <style name="V2.ScanBadge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_v2_capsule</item>
        <item name="android:paddingStart">7dp</item>
        <item name="android:paddingEnd">7dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- Étape de lecture (iOS OCRProcessingView) -->
    <style name="V2.ScanStep" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/v2_text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="V2.FieldInput" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@null</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textColor">@color/v2_text_primary</item>
        <item name="android:textColorHint">@color/v2_text_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="V2.FieldDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@color/v2_divider</item>
    </style>

    <!-- Barre d'onglets : 5 libellés lisibles jusqu'à 320 dp de large -->
    <style name="V2.TabLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Lot 10 — Réglages (iOS SettingsView : liste groupée), même présentation que « Budgets mensuels » -->
    <style name="V2.SettingsHeader" parent="V2.FieldLabel">
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:paddingStart">16dp</item>
    </style>

    <style name="V2.SettingsCard" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">@color/v2_surface_grouped</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="V2.SettingsCardContent" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="V2.SettingsRowTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/v2_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="V2.SettingsAction" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/v2_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">0dp</item>
    </style>

    <style name="V2.SettingsDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:background">@color/v2_divider</item>
    </style>

    <style name="V2.SettingsFooter" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/v2_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="V2.SettingsValueRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="V2.SettingsValueLabel" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/v2_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="V2.SettingsValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/v2_text_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Chevron de fin de ligne (ligne qui ouvre un choix) -->
    <style name="V2.SettingsChevron" parent="">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:src">@drawable/ic_v2_chevron</item>
    </style>
</resources>
