<?xml version="1.0" encoding="utf-8"?>
<!-- Saisie d'un budget — iOS BudgetEditSheet : barre haute « Annuler » / catégorie / « Appliquer » (jamais masquée
     par le clavier ; barre d'onglets masquée pendant la saisie, comme la feuille iOS), en-tête « Budget mensuel — catégorie », champ « Ex : 300 », « Supprimer le budget » si existant.
     Remplace la fenêtre de dialogue du 1er essai : sur 320 dp / police 1,3 et à police 2,0, le clavier recouvrait
     ses boutons (constaté sur émulateur, run 36642473284). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_bg_grouped"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Barre haute : « Annuler » et « Appliquer » toujours entiers et accessibles ; titre (catégorie) seulement s'il
         tient entier sur une ligne entre eux, sinon nom complet dans la zone fixe juste dessous (TitleBarRow). -->
    <com.etix.ui.common.TitleBarRow
        android:id="@+id/budgetEditBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <Button
            android:id="@+id/btnBudgetCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Annuler"
            android:textColor="@color/v2_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvBudgetEditTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/v2_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnBudgetApply"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:minHeight="48dp"
            android:text="Appliquer"
            android:textColor="@color/v2_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </com.etix.ui.common.TitleBarRow>

    <!-- Nom complet de la catégorie quand il ne tient pas dans la barre haute : zone FIXE sous la barre (hors de la zone
         défilante), toujours visible pendant la saisie, clavier ouvert, à la taille de police choisie (à la ligne entre
         les mots). Le nom n'est affiché qu'une fois : ici ou dans la barre. -->
    <TextView
        android:id="@+id/tvBudgetEditName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:hyphenationFrequency="none"
        android:paddingStart="40dp"
        android:paddingTop="4dp"
        android:paddingEnd="40dp"
        android:paddingBottom="4dp"
        android:textColor="@color/v2_text_primary"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:targetApi="p" />

    <!-- Défilements automatiques (clavier, curseur, erreur) arrêtés à une limite de bloc : aucun texte rogné en haut -->
    <com.etix.ui.common.CleanTopScrollView
        android:id="@+id/budgetEditScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/budgetEditContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvBudgetEditHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textAllCaps="true"
                android:textColor="@color/v2_text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/budgetInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Ex : 300"
                app:boxBackgroundColor="@color/v2_surface_grouped"
                app:suffixText="€">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputBudget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="0123456789,. "
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:textColor="@color/v2_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnDeleteBudget"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="48dp"
                android:text="Supprimer le budget"
                android:textColor="@color/v2_negative"
                android:visibility="gone" />
        </LinearLayout>
    </com.etix.ui.common.CleanTopScrollView>
</LinearLayout>
