<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollViewAdd"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/containerAdd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- En-tête bleu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_rounded"
            android:gravity="bottom"
            android:padding="24dp">

            <TextView
                android:id="@+id/titleAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajouter"
                android:textColor="@color/md_onPrimary"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Formulaire -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-32dp"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Magasin -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Magasin *"
                android:textColor="@color/md_onBackground"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/editTextStore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input"
                android:hint="Ex: Carrefour"
                android:padding="16dp"
                android:textColor="@color/md_onBackground"
                android:textColorHint="@color/gray_500"
                android:textSize="16sp" />

            <!-- Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date *"
                android:textColor="@color/md_onBackground"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/editTextDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="JJ/MM/AAAA"
                    android:padding="16dp"
                    android:textColor="@color/md_onBackground"
                    android:textColorHint="@color/gray_500"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnPickDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/etix_blue"
                    android:paddingHorizontal="12dp" />
            </LinearLayout>

            <!-- Montant -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Montant (€) *"
                android:textColor="@color/md_onBackground"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/editAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input"
                android:hint="0.00"
                android:inputType="numberDecimal"
                android:padding="16dp"
                android:textColor="@color/md_onBackground"
                android:textColorHint="@color/gray_500"
                android:textSize="16sp" />

            <!-- Catégorie -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Catégorie *"
                android:textColor="@color/md_onBackground"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input"
                android:padding="12dp" />

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description (optionnel)"
                android:textColor="@color/md_onBackground"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/editDescription"
                android:layout_width="match_parent"
                android:layout_height="107dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:hint="Notes..."
                android:inputType="textMultiLine"
                android:padding="16dp"
                android:textColor="@color/md_onBackground"
                android:textColorHint="@color/gray_500"
                android:textSize="16sp" />

            <!-- Bouton "Ajouter" -->
            <Button
                android:id="@+id/buttonSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ajouter"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:backgroundTint="@color/etix_blue"
                android:textColor="@color/white"
                android:layout_marginBottom="12dp" />

            <!-- Bouton "Ajout rapide" -->
            <Button
                android:id="@+id/buttonQuickAdd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ajout rapide"
                android:textAllCaps="false"
                android:backgroundTint="@color/gray_500"
                android:textColor="@color/white" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>