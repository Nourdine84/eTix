<?xml version="1.0" encoding="utf-8"?>
<!-- Fiche magasin — référence iOS StoreDetailView.
     Sections : hero, grille de stats, comparaison mensuelle, top catégories, tickets.
     Non porté dans ce lot : graphique « Historique des achats » (StoreBarChartView). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/storeDetailScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_bg_grouped"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="48dp">

        <ImageButton
            android:id="@+id/btnStoreBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Retour"
            android:src="@drawable/ic_arrow_back_v2" />

        <!-- HERO -->
        <TextView
            android:id="@+id/tvDetailStoreName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.12"
            android:textAllCaps="true"
            android:textColor="@color/v2_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDetailTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.03"
            android:textColor="@color/v2_primary"
            android:textSize="56sp" />

        <TextView
            android:id="@+id/tvDetailCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/v2_text_secondary"
            android:textSize="15sp" />

        <!-- STATS GRID 2x2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include android:id="@+id/statAverage" layout="@layout/view_v2_stat_card" />

            <Space android:layout_width="16dp" android:layout_height="1dp" />

            <include android:id="@+id/statCount" layout="@layout/view_v2_stat_card" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include android:id="@+id/statLastVisit" layout="@layout/view_v2_stat_card" />

            <Space android:layout_width="16dp" android:layout_height="1dp" />

            <include android:id="@+id/statFrequency" layout="@layout/view_v2_stat_card" />
        </LinearLayout>

        <!-- COMPARAISON MENSUELLE -->
        <LinearLayout
            android:id="@+id/cardMonthComparison"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_v2_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="COMPARAISON MENSUELLE"
                android:textColor="@color/v2_text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="CE MOIS"
                        android:textColor="@color/v2_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvThisMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/v2_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="40dp"
                    android:background="@color/v2_divider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="MOIS DERNIER"
                        android:textColor="@color/v2_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvLastMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/v2_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvVariation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- TOP CATÉGORIES -->
        <LinearLayout
            android:id="@+id/cardTopCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_v2_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="TOP CATÉGORIES"
                android:textColor="@color/v2_text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/containerTopCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- TICKETS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_v2_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvTicketsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:textColor="@color/v2_text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/containerStoreTickets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/btnShowAllTickets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:textColor="@color/v2_primary"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
