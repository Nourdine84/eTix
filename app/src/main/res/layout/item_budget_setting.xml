<?xml version="1.0" encoding="utf-8"?>
<!-- Ligne du réglage des budgets : nom complet (à la ligne entre les mots, jamais coupé en milieu de mot), budget à
     droite, ou sous le nom quand un mot ne tiendrait pas à côté (TrailingValueRow), puis chevron. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <com.etix.ui.common.TrailingValueRow
        android:id="@+id/rowBudgetSetting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvBudgetCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hyphenationFrequency="none"
            android:textColor="@color/v2_text_primary"
            android:textSize="17sp"
            tools:targetApi="m" />

        <TextView
            android:id="@+id/tvBudgetValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/v2_text_secondary"
            android:textSize="15sp" />
    </com.etix.ui.common.TrailingValueRow>

    <ImageView
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_v2_chevron"
        app:tint="@color/v2_text_secondary" />
</LinearLayout>
