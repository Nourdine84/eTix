<?xml version="1.0" encoding="utf-8"?>
<!-- Magasins — référence iOS StoreListView (feature/home-hero-v2).
     Titre grand format, sélecteur de période segmenté, cartes classées par total. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_bg_grouped"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvStoresTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:text="Magasins"
        android:textColor="@color/v2_text_primary"
        android:textSize="34sp"
        android:textStyle="bold"
        android:accessibilityHeading="true"
        tools:targetApi="p" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/togglePeriod"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button
            android:id="@+id/btnPeriodToday"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Aujourd’hui"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:maxLines="1"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnPeriodMonth"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ce mois"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:maxLines="1"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnPeriodYear"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cette année"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:maxLines="1"
            android:textSize="13sp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerStores"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="40dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/emptyStores"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_store"
                app:tint="@color/v2_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Aucun magasin sur cette période"
                android:textColor="@color/v2_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
