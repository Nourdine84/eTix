<?xml version="1.0" encoding="utf-8"?>
<!-- Catégories — référence iOS CategoryView (feature/home-hero-v2) : titre grand format, sélecteur de période,
     carte anneau + légende, lignes par catégorie, état vide « Aucun ticket sur cette période ».
     Budgets : lot 7. Non porté : export. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_bg_grouped"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="12dp"
        android:paddingTop="16dp">

        <TextView
            android:id="@+id/tvCategoriesTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Catégories"
            android:textColor="@color/v2_text_primary"
            android:textSize="34sp"
            app:autoSizeMaxTextSize="34sp"
            app:autoSizeMinTextSize="20sp"
            app:autoSizeTextType="uniform"
            android:textStyle="bold"
            android:accessibilityHeading="true"
            tools:targetApi="p" />

        <!-- Lot 7 : réglage des budgets mensuels (iOS : bouton « slider.vertical.3 » de la barre de navigation) -->
        <ImageButton
            android:id="@+id/btnBudgets"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Budgets mensuels"
            android:src="@drawable/ic_v2_budget"
            app:tint="@color/v2_primary" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/togglePeriodCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button
            android:id="@+id/btnCatToday"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Aujourd’hui"
            android:textSize="13sp"
            app:autoSizeMaxTextSize="13sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeTextType="uniform" />

        <Button
            android:id="@+id/btnCatMonth"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Ce mois"
            android:textSize="13sp"
            app:autoSizeMaxTextSize="13sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeTextType="uniform" />

        <Button
            android:id="@+id/btnCatYear"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Cette année"
            android:textSize="13sp"
            app:autoSizeMaxTextSize="13sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeTextType="uniform" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Id conservé (écran V1) : tests et captures existants -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewCategories"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="40dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/emptyCategories"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_v2_tag"
                app:tint="@color/v2_text_secondary" />

            <TextView
                android:id="@+id/tvEmptyCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Aucun ticket sur cette période"
                android:textColor="@color/v2_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
