<?xml version="1.0" encoding="utf-8"?>
<!-- Catégories — référence iOS CategoryView (feature/home-hero-v2) : titre grand format, sélecteur de période,
     carte anneau + légende, lignes par catégorie, état vide « Aucun ticket sur cette période ».
     Non porté : budgets (barre, bouton, invitation), détail d'une catégorie, export. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_bg_grouped"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvCategoriesTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:text="Catégories"
        android:textColor="@color/v2_text_primary"
        android:textSize="34sp"
        android:textStyle="bold"
        android:accessibilityHeading="true"
        tools:targetApi="p" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/togglePeriodCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button
            android:id="@+id/btnCatToday"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Aujourd’hui"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnCatMonth"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Ce mois"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnCatYear"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Cette année"
            android:textSize="13sp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Id conservé (écran V1) : tests et captures existants -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewCategories"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="40dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/emptyCategories"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_v2_tag"
                app:tint="@color/v2_text_secondary" />

            <TextView
                android:id="@+id/tvEmptyCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Aucun ticket sur cette période"
                android:textColor="@color/v2_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
