<?xml version="1.0" encoding="utf-8"?>
<!-- Carte statistique — iOS StoreDetailView.statCard -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_v2_stat"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvStatLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.1"
        android:textColor="@color/v2_text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvStatValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/v2_text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
