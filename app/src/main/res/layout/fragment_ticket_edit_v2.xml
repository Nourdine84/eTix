<?xml version="1.0" encoding="utf-8"?>
<!-- Modifier un ticket — référence iOS TicketEditView (TicketForm partagé). Retour Android = Annuler.
     « Supprimer » (suppression unitaire, existant Android) conservé. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollEdit"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_bg_home"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="Modifier"
            android:textColor="@color/v2_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:targetApi="p" />

        <include
            android:id="@+id/form"
            layout="@layout/view_ticket_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Enregistrer"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            app:backgroundTint="@color/v2_primary"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Supprimer"
            android:textColor="@color/v2_negative"
            android:textSize="17sp"
            app:backgroundTint="@color/v2_negative_12"
            app:cornerRadius="14dp" />
    </LinearLayout>
</ScrollView>
