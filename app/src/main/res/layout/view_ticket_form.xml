<?xml version="1.0" encoding="utf-8"?>
<!-- Formulaire ticket partagé Ajout / Édition — référence iOS TicketForm (carte, 5 champs). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/v2_surface_home"
    app:cardCornerRadius="20dp"
    app:cardElevation="@dimen/v2_card_elevation"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView style="@style/V2.FieldLabel" android:labelFor="@id/inputStore" android:text="MAGASIN" />
        <EditText
            android:id="@+id/inputStore"
            style="@style/V2.FieldInput"
            android:hint="Nom du magasin"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLength="60" />

        <View style="@style/V2.FieldDivider" />

        <TextView style="@style/V2.FieldLabel" android:labelFor="@id/inputAmount" android:text="MONTANT" />
        <!-- digits : accepte « , » ET « . » quelle que soit la langue du clavier (numberDecimal seul refuse
             la virgule selon la locale / la version d'Android) -->
        <EditText
            android:id="@+id/inputAmount"
            style="@style/V2.FieldInput"
            android:digits="0123456789,."
            android:hint="0,00 €"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLength="12" />

        <View style="@style/V2.FieldDivider" />

        <TextView style="@style/V2.FieldLabel" android:text="DATE" />
        <TextView
            android:id="@+id/inputDate"
            style="@style/V2.FieldInput"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="48dp" />

        <View style="@style/V2.FieldDivider" />

        <LinearLayout
            android:id="@+id/rowCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="48dp"
            android:orientation="vertical">

            <TextView style="@style/V2.FieldLabel" android:text="CATÉGORIE" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCategoryValue"
                    style="@style/V2.FieldInput"
                    android:layout_width="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_v2_chevron" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/V2.FieldDivider" />

        <TextView style="@style/V2.FieldLabel" android:labelFor="@id/inputDescription" android:text="DESCRIPTION" />
        <EditText
            android:id="@+id/inputDescription"
            style="@style/V2.FieldInput"
            android:hint="Optionnel"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="200"
            android:maxLines="4" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
