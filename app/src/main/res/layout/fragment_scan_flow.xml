<?xml version="1.0" encoding="utf-8"?>
<!-- Lot 9 — parcours de scan, référence iOS ScannerFlowView : une seule vue, étapes échangées
     (intro, autorisation caméra, lecture, rien détecté, erreur). Aucune écriture en base ici. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scanRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_bg_home"
    android:clickable="true"
    android:focusable="true">

    <!-- ===== INTRO ===== -->
    <!-- Boutons dans une barre basse toujours visible (petit écran / grande police : constaté sur émulateur,
         l'action principale sortait de l'écran) ; l'illustration et le texte défilent au-dessus. -->
    <LinearLayout
        android:id="@+id/stepIntro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingTop="24dp"
                android:paddingEnd="32dp"
                android:paddingBottom="24dp">

                <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

                <ImageView
                    android:id="@+id/imgScanFrame"
                    android:layout_width="200dp"
                    android:layout_height="250dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/img_scan_frame" />

                <TextView
                    android:id="@+id/tvScanTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:accessibilityHeading="true"
                    android:gravity="center"
                    android:text="Scanner un ticket"
                    android:textColor="@color/v2_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:targetApi="p" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Prends ton ticket en photo, à plat et en entier, ou choisis une image. La lecture se fait sur ton téléphone : aucune image n'est envoyée sur un serveur."
                    android:textColor="@color/v2_text_secondary"
                    android:textSize="15sp" />

                <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingBottom="16dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTakePhoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="52dp"
                android:text="Prendre une photo"
                android:textSize="17sp"
                app:backgroundTint="@color/v2_primary"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_v2_scan"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickImage"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="52dp"
                android:text="Choisir une image"
                android:textColor="@color/v2_primary"
                android:textSize="17sp"
                app:backgroundTint="@color/v2_primary_30"
                app:cornerRadius="14dp" />

            <Button
                android:id="@+id/btnScanCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="Annuler"
                android:textColor="@color/v2_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== AUTORISATION CAMÉRA (iOS CameraPrimingView) ===== -->
    <LinearLayout
        android:id="@+id/stepPriming"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="24dp"
            android:paddingEnd="32dp"
            android:paddingBottom="24dp">

            <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:gravity="center"
                android:text="Autoriser l'accès à ton appareil photo"
                android:textColor="@color/v2_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:targetApi="p" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Tu pourras scanner tes tickets pour en extraire automatiquement les informations. Aucune image n'est envoyée sur un serveur."
                android:textColor="@color/v2_text_secondary"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginTop="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_v2_scan"
                app:tint="@color/v2_primary" />

            <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>
    </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrimingRefuse"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="Refuser"
                    android:textColor="@color/v2_text_primary"
                    android:textSize="16sp"
                    app:backgroundTint="@color/v2_surface_home"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrimingAllow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="Autoriser"
                    android:textSize="16sp"
                    app:backgroundTint="@color/v2_primary"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== LECTURE (iOS OCRProcessingView) ===== -->
    <LinearLayout
        android:id="@+id/stepProcessing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/scanProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/v2_primary" />

        <TextView
            android:id="@+id/tvProcessingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityLiveRegion="polite"
            android:text="Lecture du ticket…"
            android:textColor="@color/v2_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStep1"
            style="@style/V2.ScanStep"
            android:layout_marginTop="24dp"
            android:text="Analyse de l'image" />

        <TextView
            android:id="@+id/tvStep2"
            style="@style/V2.ScanStep"
            android:text="Reconnaissance du texte" />

        <TextView
            android:id="@+id/tvStep3"
            style="@style/V2.ScanStep"
            android:text="Extraction des informations" />
    </LinearLayout>

    <!-- ===== RIEN DÉTECTÉ / ERREUR (iOS notFoundView) ===== -->
    <LinearLayout
        android:id="@+id/stepFailure"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="24dp"
            android:paddingEnd="32dp"
            android:paddingBottom="24dp">

            <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_v2_note"
                app:tint="@color/v2_text_secondary" />

            <TextView
                android:id="@+id/tvFailureTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textColor="@color/v2_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:targetApi="p"
                tools:text="Aucune information détectée" />

            <TextView
                android:id="@+id/tvFailureMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/v2_text_secondary"
                android:textSize="15sp" />

            <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>
    </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingBottom="16dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="52dp"
                android:text="Réessayer"
                android:textSize="17sp"
                app:backgroundTint="@color/v2_primary"
                app:cornerRadius="14dp" />

            <Button
                android:id="@+id/btnManualEntry"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="Saisir manuellement"
                android:textColor="@color/v2_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
