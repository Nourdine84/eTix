<?xml version="1.0" encoding="utf-8"?>
<!-- iOS BudgetSummaryCardView.budgetLineRow : nom (90), capsule 4, pourcentage (40) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="28dp"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/tvLineName"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/v2_text_primary"
        android:textSize="12sp"
        app:autoSizeMaxTextSize="12sp"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeTextType="uniform" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/lineBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:max="1000"
        app:indicatorTrackGapSize="0dp"
        app:trackColor="@color/v2_fill"
        app:trackCornerRadius="2dp"
        app:trackStopIndicatorSize="0dp"
        app:trackThickness="4dp" />

    <TextView
        android:id="@+id/tvLinePercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:minWidth="40dp"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
