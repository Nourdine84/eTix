<?xml version="1.0" encoding="utf-8"?>
<!-- Carte ticket — iOS TicketHistoryView.ticketCard : magasin, « catégorie · date », montant bleu.
     Nom du magasin sur deux lignes au plus (coupure entre les mots) ; si le nom ne tient pas à côté du montant
     (petit écran, grande police), le montant passe sous la date. Disposition et écart de 12 dp : TicketCardRow. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/v2_surface_grouped"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <com.etix.ui.history.TicketCardRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/ticketTextColumn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:hyphenationFrequency="none"
                android:maxLines="2"
                android:textColor="@color/v2_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:targetApi="m" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/v2_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/v2_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </com.etix.ui.history.TicketCardRow>
</com.google.android.material.card.MaterialCardView>
