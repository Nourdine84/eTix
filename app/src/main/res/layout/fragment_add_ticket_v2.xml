<?xml version="1.0" encoding="utf-8"?>
<!-- Ajouter un ticket — référence iOS AddTicketView : scanner (secondaire, indisponible sur Android),
     formulaire TicketForm (magasin, montant, date, catégorie, description), Enregistrer. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollViewAdd"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_bg_home"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/containerAdd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/titleAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="Ajouter un ticket"
            android:textColor="@color/v2_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:targetApi="p" />

        <!-- iOS : bouton scanner secondaire. Flux scanner non branché sur Android → désactivé et signalé. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanTicket"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:contentDescription="Scanner un ticket, indisponible sur Android pour le moment"
            android:enabled="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Scanner un ticket — indisponible"
            android:textColor="@color/v2_disabled_on_primary"
            app:backgroundTint="@color/v2_disabled_primary"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_v2_scan"
            app:iconGravity="textStart"
            app:iconTint="@color/v2_disabled_on_primary" />

        <include
            android:id="@+id/form"
            layout="@layout/view_ticket_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveTicket"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Enregistrer"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            app:backgroundTint="@color/v2_primary"
            app:cornerRadius="14dp" />
    </LinearLayout>
</ScrollView>
