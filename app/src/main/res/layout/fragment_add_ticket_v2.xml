<?xml version="1.0" encoding="utf-8"?>
<!-- Ajouter un ticket — référence iOS AddTicketView : scanner (secondaire, lot 9),
     formulaire TicketForm (magasin, montant, date, catégorie, description), Enregistrer. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollViewAdd"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_bg_home"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/containerAdd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/titleAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="Ajouter un ticket"
            android:textColor="@color/v2_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:targetApi="p" />

        <!-- iOS : bouton scanner secondaire (lot 9 : parcours de scan branché). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanTicket"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="52dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Scanner un ticket"
            android:textColor="@color/v2_primary"
            android:textSize="17sp"
            app:backgroundTint="@color/v2_primary_30"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_v2_scan"
            app:iconGravity="textStart"
            app:iconTint="@color/v2_primary" />

        <!-- Après un scan : rappel de vérification + « Annuler le scan » (vide le formulaire, aucun ticket créé) -->
        <!-- Vertical : en grande police sur petit écran, le bouton à côté du texte l'écrasait lettre par lettre
             (constaté sur l'aperçu 320 dp / police 2,0). -->
        <LinearLayout
            android:id="@+id/scanBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_v2_scan_banner"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvScanBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:accessibilityLiveRegion="polite"
                android:text="Informations détectées sur le ticket, non vérifiées. Contrôle chaque champ avant d'enregistrer."
                android:textColor="@color/v2_text_primary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnDiscardScan"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:minHeight="48dp"
                android:text="Annuler le scan"
                android:textColor="@color/v2_primary" />
        </LinearLayout>

        <include
            android:id="@+id/form"
            layout="@layout/view_ticket_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveTicket"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Enregistrer"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            app:backgroundTint="@color/v2_primary"
            app:cornerRadius="14dp" />
    </LinearLayout>
</ScrollView>
